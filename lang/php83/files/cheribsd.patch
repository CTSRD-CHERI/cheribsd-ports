diff --git Zend/asm/jump_arm64_morello_elf_gas.S Zend/asm/jump_arm64_morello_elf_gas.S
new file mode 100644
index 00000000000..7f2eceecbfe
--- /dev/null
+++ Zend/asm/jump_arm64_morello_elf_gas.S
@@ -0,0 +1,135 @@
+/*
+       Copyright Edward Nevill + Oliver Kowalke 2015
+   Distributed under the Boost Software License, Version 1.0.
+      (See accompanying file LICENSE_1_0.txt or copy at
+          http://www.boost.org/LICENSE_1_0.txt)
+*/
+/*******************************************************
+ *                                                     *
+ *  -------------------------------------------------  *
+ *  |  0  |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  *
+ *  -------------------------------------------------  *
+ *  | 0x0 | 0x4 | 0x8 | 0xc | 0x10| 0x14| 0x18| 0x1c|  *
+ *  -------------------------------------------------  *
+ *  |    d8     |    d9     |    d10    |    d11    |  *
+ *  -------------------------------------------------  *
+ *  -------------------------------------------------  *
+ *  |  8  |  9  |  10 |  11 |  12 |  13 |  14 |  15 |  *
+ *  -------------------------------------------------  *
+ *  | 0x20| 0x24| 0x28| 0x2c| 0x30| 0x34| 0x38| 0x3c|  *
+ *  -------------------------------------------------  *
+ *  |    d12    |    d13    |    d14    |    d15    |  *
+ *  -------------------------------------------------  *
+ *  -------------------------------------------------  *
+ *  |  16 |  17 |  18 |  19 |  20 |  21 |  22 |  23 |  *
+ *  -------------------------------------------------  *
+ *  | 0x40| 0x44| 0x48| 0x4c| 0x50| 0x54| 0x58| 0x5c|  *
+ *  -------------------------------------------------  *
+ *  |          c19          |          c20          |  *
+ *  -------------------------------------------------  *
+ *  -------------------------------------------------  *
+ *  |  24 |  25 |  26 |  27 |  28 |  29 |  30 |  31 |  *
+ *  -------------------------------------------------  *
+ *  | 0x60| 0x64| 0x68| 0x6c| 0x70| 0x74| 0x78| 0x7c|  *
+ *  -------------------------------------------------  *
+ *  |          c21          |          c22          |  *
+ *  -------------------------------------------------  *
+ *  -------------------------------------------------  *
+ *  |  32 |  33 |  34 |  35 |  36 |  37 |  38 |  39 |  *
+ *  -------------------------------------------------  *
+ *  | 0x80| 0x84| 0x88| 0x8c| 0x90| 0x94| 0x98| 0x9c|  *
+ *  -------------------------------------------------  *
+ *  |          c23          |          c24          |  *
+ *  -------------------------------------------------  *
+ *  -------------------------------------------------  *
+ *  |  40 |  41 |  42 |  43 |  44 |  45 |  46 |  47 |  *
+ *  -------------------------------------------------  *
+ *  | 0xa0| 0xa4| 0xa8| 0xac| 0xb0| 0xb4| 0xb8| 0xbc|  *
+ *  -------------------------------------------------  *
+ *  |          c25          |          c26          |  *
+ *  -------------------------------------------------  *
+ *  -------------------------------------------------  *
+ *  |  48 |  49 |  50 |  51 |  52 |  53 |  54 |  55 |  *
+ *  -------------------------------------------------  *
+ *  | 0xc0| 0xc4| 0xc8| 0xcc| 0xd0| 0xd4| 0xd8| 0xdc|  *
+ *  -------------------------------------------------  *
+ *  |          c27          |          c28          |  *
+ *  -------------------------------------------------  *
+ *  -------------------------------------------------  *
+ *  |  56 |  57 |  58 |  59 |  60 |  61 |  62 |  63 |  *
+ *  -------------------------------------------------  *
+ *  | 0xe0| 0xe4| 0xe8| 0xec| 0xf0| 0xf4| 0xf8| 0xfc|  *
+ *  -------------------------------------------------  *
+ *  |           FP          |           LR          |  *
+ *  -------------------------------------------------  *
+ *  -------------------------------------------------  *
+ *  |  64 |  65 |  66 | 67  |           |           |  *
+ *  -------------------------------------------------  *
+ *  |0x100|0x104|0x108|0x10c|           |           |  *
+ *  -------------------------------------------------  *
+ *  |           PC          |                       |  *
+ *  -------------------------------------------------  *
+ *                                                     *
+ *******************************************************/
+
+.file "jump_arm64_aapcs_elf_gas.S"
+.text
+.align  2
+.global jump_fcontext
+.type   jump_fcontext, %function
+jump_fcontext:
+    # prepare stack for GP + FPU
+    sub  csp, csp, #0x110
+
+    # save d8 - d15
+    stp  d8,  d9,  [csp, #0x00]
+    stp  d10, d11, [csp, #0x10]
+    stp  d12, d13, [csp, #0x20]
+    stp  d14, d15, [csp, #0x30]
+
+    # save x19-x30
+    stp  c19, c20, [csp, #0x40]
+    stp  c21, c22, [csp, #0x60]
+    stp  c23, c24, [csp, #0x80]
+    stp  c25, c26, [csp, #0xa0]
+    stp  c27, c28, [csp, #0xc0]
+    stp  c29, c30, [csp, #0xe0]
+
+    # save LR as PC
+    str  c30, [csp, #0x100]
+
+    # store RSP (pointing to context-data) in C0
+    mov  c4, csp
+
+    # restore RSP (pointing to context-data) from C1
+    mov  csp, c0
+
+    # load d8 - d15
+    ldp  d8,  d9,  [csp, #0x00]
+    ldp  d10, d11, [csp, #0x10]
+    ldp  d12, d13, [csp, #0x20]
+    ldp  d14, d15, [csp, #0x30]
+
+    # load x19-x30
+    ldp  c19, c20, [csp, #0x40]
+    ldp  c21, c22, [csp, #0x60]
+    ldp  c23, c24, [csp, #0x80]
+    ldp  c25, c26, [csp, #0xa0]
+    ldp  c27, c28, [csp, #0xc0]
+    ldp  c29, c30, [csp, #0xe0]
+
+    # return transfer_t from jump
+    # pass transfer_t as first arg in context function
+    # C0 == FCTX, C1 == DATA
+    mov c0, c4
+
+    # load pc
+    ldr  c4, [csp, #0x100]
+
+    # restore stack from GP + FPU
+    add  csp, csp, #0x110
+
+    ret c4
+.size   jump_fcontext,.-jump_fcontext
+# Mark that we don't need executable stack.
+.section .note.GNU-stack,"",%progbits
